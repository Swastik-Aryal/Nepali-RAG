QDRANT_URL="YOUR_QDRANT_ENDPOINT_URL"
QDRANT_API_KEY="YOUR_API_KEY"
COLLECTION_NAME=nepali_docs
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LLM_PROVIDER=vllm
VLLM_MODEL=google/gemma-3-4b-it
VLLM_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
TESSERACT_LANGUAGES=nep
CHUNK_SIZE=312
CHUNK_OVERLAP_SENTENCES=2
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
DENSE_WEIGHT = 0.9
SPARSE_WEIGHT = 0.1
# Set to true to let the LLM decide when retrieval is needed (tool-calling mode).
# When false, every query triggers retrieval (default, always-retrieve mode).
USE_TOOLS=false