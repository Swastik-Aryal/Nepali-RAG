QDRANT_URL="YOUR_QDRANT_ENDPOINT_URL"
QDRANT_API_KEY="YOUR_API_KEY"
COLLECTION_NAME=nepali_docs
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_PROVIDER=ollama
VLLM_MODEL=google/gemma-4-E4B-it
VLLM_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
# Set OPENAI_BASE_URL for OpenAI-compatible providers (Groq, DeepSeek, etc.)
# Leave empty to use the official OpenAI API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
HF_MODEL_NAME=Qwen/Qwen3.6-35B-A3B
HF_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN="YOUR_API_KEY"
ANTHROPIC_API_KEY="YOUR_API_KEY"
ANTHROPIC_MODEL=claude-opus-4-6
TESSERACT_LANGUAGES=nep
CHUNK_SIZE=256
CHUNK_OVERLAP_SENTENCES=2
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
DENSE_WEIGHT = 0.9
SPARSE_WEIGHT = 0.1
LLM_TEMPERATURE = 0.3
# Set to True to let the LLM decide when retrieval is needed (tool-calling mode).
# When False, every query triggers retrieval (default, always-retrieve mode).
USE_TOOLS=True